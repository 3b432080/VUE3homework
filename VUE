<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>現代版 BMI 計算機</title>
  
  <!-- 引入 Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- 引入 Vue 3 -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

  <!-- 引入 Google Fonts: Noto Sans TC -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Noto Sans TC"', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* 隱藏數字輸入框的原生上下箭頭 */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    input[type="number"] {
      -moz-appearance: textfield;
    }
    
    /* 漸層動畫背景 */
    .bg-animated {
      background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
      background-size: 400% 400%;
      animation: gradientBG 15s ease infinite;
    }
    @keyframes gradientBG {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
  </style>
</head>
<body class="bg-animated min-h-screen flex items-center justify-center p-4 antialiased selection:bg-indigo-200 selection:text-indigo-900">

  <!-- Vue 應用程式掛載點 -->
  <div id="app" class="w-full max-w-md">
    
    <!-- 毛玻璃卡片主體 -->
    <div class="bg-white/80 backdrop-blur-xl shadow-2xl rounded-[2rem] p-8 sm:p-10 border border-white/50 transition-all duration-500 hover:shadow-indigo-500/20">
      
      <!-- 標題區塊 -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-indigo-100 text-indigo-500 mb-4 shadow-inner">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
        <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">BMI 計算機</h1>
        <p class="text-sm text-gray-500 mt-2">隨時關注您的健康指標</p>
      </div>

      <!-- 輸入表單區塊 -->
      <div class="space-y-6">
        
        <!-- 身高輸入 (使用 v-model) -->
        <div class="group">
          <label for="height" class="block text-sm font-bold text-gray-700 mb-2 transition-colors group-focus-within:text-indigo-600">身高 (公分)</label>
          <div class="relative">
            <input 
              id="height" 
              type="number" 
              v-model="height" 
              placeholder="例如: 175"
              class="block w-full pl-4 pr-12 py-3.5 bg-white/50 border border-gray-200 rounded-2xl text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-4 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-300 text-lg shadow-sm"
            >
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium">cm</span>
          </div>
        </div>

        <!-- 體重輸入 (使用 v-model) -->
        <div class="group">
          <label for="weight" class="block text-sm font-bold text-gray-700 mb-2 transition-colors group-focus-within:text-indigo-600">體重 (公斤)</label>
          <div class="relative">
            <input 
              id="weight" 
              type="number" 
              v-model="weight" 
              placeholder="例如: 65"
              class="block w-full pl-4 pr-12 py-3.5 bg-white/50 border border-gray-200 rounded-2xl text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-4 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all duration-300 text-lg shadow-sm"
            >
            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 font-medium">kg</span>
          </div>
        </div>

      </div>

      <!-- 計算結果顯示區塊 -->
      <div class="mt-10 pt-8 border-t border-gray-200/60 text-center">
        <!-- 尚未輸入完整資料的提示 -->
        <div v-if="!isValid" class="text-gray-400 text-sm font-medium animate-pulse">
          請輸入有效的身高與體重以查看結果
        </div>
        
        <!-- 顯示結果 -->
        <div v-else class="transition-all duration-500 transform scale-100 opacity-100">
          <p class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-1">您的 BMI 指數</p>
          
          <!-- computed: 計算出的 BMI 數值 -->
          <div class="text-[3.5rem] leading-none font-black mb-3 drop-shadow-sm" :class="bmiStatus.colorClass">
            {{ bmiValue }}
          </div>
          
          <!-- computed: 動態體態狀態與顏色 -->
          <div class="inline-flex items-center justify-center px-4 py-1.5 rounded-full bg-gray-50 border border-gray-100 shadow-sm">
            <span class="w-2 h-2 rounded-full mr-2" :class="bmiStatus.bgClass"></span>
            <span class="font-bold text-lg" :class="bmiStatus.colorClass">{{ bmiStatus.text }}</span>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script>
    const { createApp, ref, computed } = Vue;

    createApp({
      setup() {
        // --- 1. 定義 Ref 資料 ---
        const height = ref('');
        const weight = ref('');

        // 檢查是否有有效輸入
        const isValid = computed(() => {
          const h = parseFloat(height.value);
          const w = parseFloat(weight.value);
          return !isNaN(h) && h > 0 && !isNaN(w) && w > 0;
        });

        // --- 2. 包含 Computed 計算屬性 (計算 BMI) ---
        const bmiValue = computed(() => {
          if (!isValid.value) return 0;
          const heightInMeters = height.value / 100;
          const bmi = weight.value / (heightInMeters * heightInMeters);
          return bmi.toFixed(1); // 取小數點後 1 位，畫面更簡潔
        });

        // --- 3. 包含 Computed 計算屬性 (動態判定狀態與文字顏色) ---
        const bmiStatus = computed(() => {
          const bmi = parseFloat(bmiValue.value);
          
          if (bmi < 18.5) {
            return { text: '體重過輕', colorClass: 'text-blue-500', bgClass: 'bg-blue-500' };
          } else if (bmi >= 18.5 && bmi < 24) {
            return { text: '正常範圍', colorClass: 'text-emerald-500', bgClass: 'bg-emerald-500' };
          } else if (bmi >= 24 && bmi < 27) {
            return { text: '過重', colorClass: 'text-yellow-500', bgClass: 'bg-yellow-500' };
          } else if (bmi >= 27 && bmi < 30) {
            return { text: '輕度肥胖', colorClass: 'text-orange-500', bgClass: 'bg-orange-500' };
          } else if (bmi >= 30 && bmi < 35) {
            return { text: '中度肥胖', colorClass: 'text-rose-500', bgClass: 'bg-rose-500' };
          } else {
            return { text: '重度肥胖', colorClass: 'text-red-700', bgClass: 'bg-red-700' };
          }
        });

        return {
          height,
          weight,
          isValid,
          bmiValue,
          bmiStatus
        };
      }
    }).mount('#app');
  </script>
</body>
</html>
